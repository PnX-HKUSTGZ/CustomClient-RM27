[sub_resource type="SystemFont" id="Font"]
font_names = PackedStringArray("Bahnschrift", "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans CJK SC", "sans-serif")
font_weight = 600

[resource]
default_font = SubResource("Font")
default_font_size = 18
Button/colors/font_color = Color(0.886, 0.902, 0.922, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(1, 1, 1, 1)
